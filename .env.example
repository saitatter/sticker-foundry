# StickerFoundry configuration example.
# Copy this file to .env at the repository root for Docker Compose and local development.

# Local backend development. Docker Compose overrides DATABASE_URL internally.
DATABASE_URL=postgresql://stickers:stickers@localhost:5432/stickers?schema=public
PORT=3000
DATA_DIR=./apps/backend/data

# Docker Compose PostgreSQL service.
POSTGRES_DB=stickers
POSTGRES_USER=stickers
POSTGRES_PASSWORD=change-this-postgres-password

# Auth and public URLs.
JWT_SECRET=change-this-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_ENABLED=true
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_NAME=stickerfoundry_refresh
AUTH_REFRESH_COOKIE_PATH=/api/auth
PUBLIC_BASE_URL=http://localhost:3000/api
PASSWORD_RESET_PUBLIC_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Instance settings.
INSTANCE_NAME=StickerFoundry
INSTANCE_DESCRIPTION=Self-hosted sticker pack management
REGISTRATION_MODE=open
REGISTRATION_INVITE_CODE=
STORAGE_QUOTA_BYTES=

# Storage. Use disk by default; set STORAGE_DRIVER=s3 and fill S3_* for S3-compatible storage.
EXPORT_CACHE_DIR=
STORAGE_DRIVER=disk
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PREFIX=packs
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Media processing safeguards.
UPLOAD_MAX_PIXELS=25000000
UPLOAD_MAX_TOTAL_PIXELS=80000000
UPLOAD_MAX_ANIMATED_EDIT_PIXELS=20000000
UPLOAD_MAX_ANIMATED_FRAMES=300
MEDIA_QUEUE_CONCURRENCY=1
EXPORT_QUEUE_CONCURRENCY=1
EMAIL_QUEUE_CONCURRENCY=2
MEDIA_QUEUE_MAX_WAITING=50
MEDIA_QUEUE_RETRY_AFTER_SECONDS=5
# Leave empty for the threshold fallback; docker-compose.ai.yml enables rembg.
BACKGROUND_REMOVAL_COMMAND=

# Rate limiting and retention.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
AUDIT_RETENTION_DAYS=

# Password reset email.
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
