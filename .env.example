# Copy to .env. Use unique credentials for each installation.
APP_ENV=development
DATABASE_URL=postgresql://stickers:stickers@localhost:5432/stickers
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./apps/backend/data
POSTGRES_DB=stickers
POSTGRES_USER=stickers
POSTGRES_PASSWORD=stickers
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=3000
WEB_HOST_PORT=8080
JWT_SECRET=local-development-secret-change-before-deployment
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_ENABLED=true
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
PASSWORD_RESET_PUBLIC_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
INSTANCE_NAME=Sticker Foundry
INSTANCE_DESCRIPTION=Self-hosted sticker pack management
REGISTRATION_MODE=open
REGISTRATION_INVITE_CODE=
STORAGE_QUOTA_BYTES=
AUDIT_RETENTION_DAYS=
STORAGE_DRIVER=disk
EXPORT_CACHE_DIR=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PREFIX=packs
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_PIXELS=25000000
UPLOAD_MAX_TOTAL_PIXELS=80000000
UPLOAD_MAX_ANIMATED_EDIT_PIXELS=20000000
UPLOAD_MAX_ANIMATED_FRAMES=300
QUEUE_PREFIX=sticker-foundry
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000
MEDIA_QUEUE_CONCURRENCY=1
EXPORT_QUEUE_CONCURRENCY=1
EMAIL_QUEUE_CONCURRENCY=2
MEDIA_QUEUE_MAX_WAITING=50
MEDIA_QUEUE_RETRY_AFTER_SECONDS=5
# AI Compose overlay configures rembg; leave empty for threshold removal.
BACKGROUND_REMOVAL_COMMAND=
BACKGROUND_REMOVAL_TIMEOUT_MS=120000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
