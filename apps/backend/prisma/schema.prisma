generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String
  passwordHash String
  packs        Pack[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Pack {
  id               String    @id @default(uuid())
  name             String
  publisher        String
  description      String?
  isPublic         Boolean   @default(false)
  imageDataVersion String    @default("1")
  ownerId          String
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stickers         Sticker[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([ownerId])
  @@index([isPublic])
}

model Sticker {
  id                String   @id @default(uuid())
  packId            String
  pack              Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  fileName          String
  emojis            String[]
  accessibilityText String?
  sizeBytes         Int
  sha256            String
  position          Int      @default(0)
  createdAt         DateTime @default(now())

  @@unique([packId, fileName])
  @@index([packId])
  @@index([packId, position])
}
