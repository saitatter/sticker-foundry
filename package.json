{
  "name": "sticker-foundry",
  "private": true,
  "version": "1.3.0",
  "description": "Self-hosted collaborative WhatsApp sticker pack management platform.",
  "workspaces": [
    "apps/backend",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "concurrently -n backend,worker,web -c cyan,magenta,green \"npm run dev:backend\" \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:seeded": "npm run prisma:migrate && npm run prisma:seed && npm run dev",
    "dev:backend": "npm --workspace apps/backend run start:dev",
    "dev:worker": "npm --workspace apps/backend run start:worker:dev",
    "dev:web": "cd apps/client && flutter run -d web-server --web-hostname 127.0.0.1 --web-port 5173 --dart-define=API_BASE_URL=http://127.0.0.1:3000/api/",
    "build:backend": "npm --workspace apps/backend run build",
    "build:web": "cd apps/client && flutter build web --release --no-web-resources-cdn",
    "prisma:generate": "npm --workspace apps/backend run prisma:generate",
    "prisma:migrate": "npm --workspace apps/backend run prisma:migrate",
    "prisma:seed": "npm --workspace apps/backend run prisma:seed",
    "test:backend": "npm --workspace apps/backend run test",
    "test:live": "node scripts/test-live-parity.mjs",
    "test:e2e:backend": "npm --workspace apps/backend run test:e2e",
    "test:web": "playwright test",
    "test:web:unit": "npm run test:client",
    "compose:validate": "node scripts/validate-compose.mjs",
    "lint:backend": "npm --workspace apps/backend run lint",
    "lint:web": "npm run lint:client",
    "format:web": "npm run format:client",
    "verify:backup": "node scripts/verify-backup.mjs",
    "package:release": "node scripts/prepare-release-assets.mjs",
    "build:shared-types": "npm --workspace packages/shared-types run build",
    "api:generate": "openapi-typescript http://localhost:3000/api/docs-json -o packages/shared-types/openapi.d.ts",
    "postinstall": "npm run prisma:generate",
    "release:dry-run": "semantic-release --dry-run",
    "dev:desktop": "cd apps/client && flutter run -d windows",
    "build:android": "cd apps/client && flutter build apk --debug",
    "build:desktop": "cd apps/client && flutter build windows --release",
    "test:client": "cd apps/client && flutter test",
    "lint:client": "cd apps/client && flutter analyze",
    "format:client": "cd apps/client && dart format lib test tool",
    "brand:sync": "cd apps/client && dart run tool/sync_brand.dart",
    "brand:check": "cd apps/client && dart run tool/sync_brand.dart --check",
    "repo:check": "node scripts/check-repo-hygiene.mjs",
    "preview:web": "node scripts/serve-client.mjs"
  },
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "concurrently": "^9.2.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.3"
  },
  "overrides": {
    "multer": "^2.5.0",
    "js-yaml@>=5": "^5.5.0",
    "deepmerge-ts": "^8.0.2"
  }
}
