APP_ENV=production
POSTGRES_DB=stickers
POSTGRES_USER=stickers
POSTGRES_PASSWORD=replace-with-a-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_BASE_URL=https://stickers.example.com
PASSWORD_RESET_PUBLIC_URL=https://stickers.example.com
CORS_ORIGIN=https://stickers.example.com
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=lax
# Register the initial administrator before closing registration.
REGISTRATION_MODE=open
WEB_HOST_PORT=8080
BACKEND_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
STORAGE_DRIVER=disk
STORAGE_QUOTA_BYTES=
AUDIT_RETENTION_DAYS=90
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set to an exact published version when using docker-compose.ghcr.yml.
STICKER_FOUNDRY_VERSION=
