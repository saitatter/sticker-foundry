# Copy this file to .env and replace every CHANGE_ME value before starting.

# Published container versions.
STICKER_FOUNDRY_IMAGE_TAG=v1.3.0
STICKER_FOUNDRY_BACKEND_IMAGE=ghcr.io/saitatter/sticker-foundry-backend
STICKER_FOUNDRY_WEB_IMAGE=ghcr.io/saitatter/sticker-foundry-web
APP_VERSION=v1.3.0

# Public web address. Keep the API behind the web gateway at /api.
PUBLIC_BASE_URL=https://stickers.example.com
PASSWORD_RESET_PUBLIC_URL=https://stickers.example.com
CORS_ORIGIN=https://stickers.example.com
WEB_PORT=8080

# Database credentials. Use long random values.
POSTGRES_DB=stickers
POSTGRES_USER=stickers
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Authentication secret. Use a different long random value.
JWT_SECRET=CHANGE_ME_long_random_jwt_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_ENABLED=true
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_NAME=stickerfoundry_refresh
AUTH_REFRESH_COOKIE_PATH=/api/auth

# Instance settings.
INSTANCE_NAME=Sticker Foundry
INSTANCE_DESCRIPTION=Self-hosted sticker pack management
REGISTRATION_MODE=invite-only
REGISTRATION_INVITE_CODE=CHANGE_ME_invite_code
STORAGE_QUOTA_BYTES=

# Persistent storage. Disk storage is kept in the foundry-data volume.
STORAGE_DRIVER=disk
EXPORT_CACHE_DIR=/data/export-cache
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PREFIX=packs
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Media processing and queues.
UPLOAD_MAX_PIXELS=25000000
UPLOAD_MAX_TOTAL_PIXELS=80000000
UPLOAD_MAX_ANIMATED_EDIT_PIXELS=20000000
UPLOAD_MAX_ANIMATED_FRAMES=300
MEDIA_QUEUE_CONCURRENCY=1
EXPORT_QUEUE_CONCURRENCY=1
EMAIL_QUEUE_CONCURRENCY=2
MEDIA_QUEUE_MAX_WAITING=50
MEDIA_QUEUE_RETRY_AFTER_SECONDS=5
BACKGROUND_REMOVAL_COMMAND=rembg i {input} {output}
U2NET_HOME=/data/rembg
QUEUE_PREFIX=sticker-foundry
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000

# Rate limiting and audit retention.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
AUDIT_RETENTION_DAYS=

# Password reset email. Leave empty until SMTP is configured.
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
