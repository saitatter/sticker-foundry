{
  "version": 1,
  "covers": ["auth.login"],
  "preconditions": "The app is signed out and configured for an isolated QA server. QA_EMAIL and QA_PASSWORD refer to a test account. Selectors and restart were verified on the physical device.",
  "steps": [
    {"action": "launch", "restart": true},
    {"action": "assert", "selector": {"label": "Sign in"}},
    {"action": "input", "selector": {"className": "android.widget.EditText", "instance": 0}, "env": "QA_EMAIL"},
    {"action": "input", "selector": {"className": "android.widget.EditText", "instance": 1}, "env": "QA_PASSWORD"},
    {"action": "press", "key": "back"},
    {"action": "tap", "selector": {"label": "Sign in"}},
    {"action": "assert", "selector": {"label": "Your library"}}
  ]
}
